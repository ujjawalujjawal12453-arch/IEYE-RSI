<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══ AWAAZ ═══ -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ═══ BACKGROUND SERVICE (wake word) ═══ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ⏰ Reminder ka asli alarm (spec section 26).
         SCHEDULE_EXACT_ALARM Android 12/13 pe user se poochta hai,
         USE_EXACT_ALARM 14+ pe seedha milti hai (alarm app ke liye). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.WAKE_LOCK" />

    <!-- ═══ PHONE CONTROL ═══ -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Android 11+ pe doosri app kholne ke liye ye zaroori hai -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="IEYE RIS"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.IeyeRis">

        <!-- 🔑 v4.3 — LICENSE SABSE PEHLE
             User ne kaha: "jab dalega na sabse pehle key hi
             maangega". Isliye LAUNCHER ab yahi hai, MainActivity
             nahi. Bina sahi key ke app khulti hi nahi. -->
        <activity
            android:name=".LicenseActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- Assistant button dabane pe bhi IEYE RIS khule -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 🎙️ Bubble tap pe khulti hai — transparent, sirf card -->
        <activity
            android:name=".VoiceActivity"
            android:exported="false"
            android:theme="@style/Theme.IeyeRis.Clear"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:noHistory="true" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="Setup"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <!-- 🫧 Floating bubble — home screen pe tairta circle -->
        <service
            android:name=".Bubble"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Wake word sunne wali service -->
        <service
            android:name=".WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 👁️ EYES — screen padhne aur button dabane ke liye.
             User ko khud on karna padta hai (Settings → Accessibility) -->
        <service
            android:name=".Eyes"
            android:exported="true"
            android:label="IEYE RIS"
            android:permission=
                "android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action
                    android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/eyes_config" />
        </service>

        <!-- Phone lock karne ke liye -->
        <receiver
            android:name=".LockAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action
                    android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 🔔 Notification padhne/jawab dene wali service.
             ⚠️ Ye bahut taakatwar permission hai — user khud
             Settings me on karega, tabhi chalegi. -->
        <service
            android:name=".Notif"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ⏰ Reminder bajane wala -->
        <receiver
            android:name=".Reminders$Fire"
            android:exported="false" />

        <!-- Phone on hote hi IEYE RIS chalu -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
